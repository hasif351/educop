# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/educop?schema=public"
# Direct connection for migrations (same as DATABASE_URL when not using a pooler)
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/educop?schema=public"
# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-string"
# Session length in hours
SESSION_TTL_HOURS=12
# Set to "true" on a demo deployment to list the demo accounts on the login page
SHOW_DEMO_ACCOUNTS="false"
# Optional: turns on real AI for the study buddy and teacher assistant.
# Without it those screens use clearly labelled template suggestions.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Optional: Vercel Blob read-write token. Turns on video upload for recorded classes.
# Without it teachers paste a link to a video file instead.
BLOB_READ_WRITE_TOKEN=
# Optional: Educop live (beta), the built-in live video on LiveKit. Create a free
# project at https://cloud.livekit.io and copy its URL (wss://...), API key and secret.
# Without all three, "Educop live (beta)" is shown but can't be chosen.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
