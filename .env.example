# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/educop?schema=public"
# Direct connection for migrations (same as DATABASE_URL when not using a pooler)
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/educop?schema=public"
# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-string"
# Session length in hours
SESSION_TTL_HOURS=12
# Set to "true" on a demo deployment to list the demo accounts on the login page
SHOW_DEMO_ACCOUNTS="false"
# Optional: turns on real AI for the study buddy and teacher assistant.
# Without it those screens use clearly labelled template suggestions.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
