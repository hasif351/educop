// Educop MVP data model.
// Multi-school: every school-owned row carries schoolId, and all reads/writes
// go through src/lib/tenant.ts which scopes queries to the signed-in user's school.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection. Vercel's Neon integration sets both.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  STUDENT
  TEACHER
  PARENT
  SCHOOL_ADMIN
  SUPER_ADMIN
}

enum ContentStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MCQ
  SHORT
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum RecommendationStatus {
  PENDING_REVIEW
  ACTIVE
  DONE
  DISMISSED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  schools   School[]
}

model School {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
  name                  String
  slug                  String       @unique
  city                  String?
  curriculum            String       @default("British")
  timezone              String       @default("Asia/Dubai")
  active                Boolean      @default(true)
  plan                  String       @default("Pilot")
  seatLimit             Int          @default(500)
  // When true, lessons need school-admin approval before students see them.
  requireLessonApproval Boolean      @default(false)
  aiEnabled             Boolean      @default(true)
  createdAt             DateTime     @default(now())

  users         User[]
  subjects      Subject[]
  classes       Class[]
  lessons       Lesson[]
  assignments   Assignment[]
  academicYears AcademicYear[]
  auditLogs     AuditLog[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  startsOn  DateTime
  endsOn    DateTime
  isCurrent Boolean  @default(false)
  classes   Class[]

  @@index([schoolId])
}

model User {
  id           String    @id @default(cuid())
  // Null only for SUPER_ADMIN, who works across schools.
  schoolId     String?
  school       School?   @relation(fields: [schoolId], references: [id])
  role         Role
  email        String    @unique
  name         String
  passwordHash String
  gradeLevel   Int? // students only: 0 = KG2, -1 = KG1, 1..12
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  // Accessibility, language and notification preferences (see src/lib/prefs.ts).
  prefs        Json      @default("{}")
  // Students only: total points earned (see PointEvent).
  points       Int       @default(0)

  teaching          Class[]            @relation("ClassTeacher")
  enrollments       Enrollment[]
  childrenLinks     ParentStudent[]    @relation("ParentLink")
  parentLinks       ParentStudent[]    @relation("ChildLink")
  lessonProgress    LessonProgress[]
  submissions       Submission[]
  recommendations   Recommendation[]
  createdLessons    Lesson[]           @relation("LessonAuthor")
  createdAssigns    Assignment[]       @relation("AssignmentAuthor")
  auditLogs         AuditLog[]
  notifications     Notification[]
  consents          Consent[]
  sentMessages      Message[]          @relation("MessageFrom")
  receivedMessages  Message[]          @relation("MessageTo")
  cognitiveSessions CognitiveSession[]
  selCheckins       SelCheckin[]
  selGoals          SelGoal[]
  badges            StudentBadge[]
  pointEvents       PointEvent[]
  aiMessages        AiMessage[]
  aiDrafts          AiDraft[]
  liveSessions      LiveSession[]
  liveAttendance    LiveAttendance[]
  liveChat          LiveChat[]
  recordings        Recording[]
  recordingViews    RecordingView[]

  @@index([schoolId, role])
}

model ParentStudent {
  parentId  String
  studentId String
  parent    User     @relation("ParentLink", fields: [parentId], references: [id])
  student   User     @relation("ChildLink", fields: [studentId], references: [id])
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([parentId, studentId])
}

model Subject {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  name     String
  code     String
  color    String  @default("blue")
  classes  Class[]

  @@unique([schoolId, code])
}

model Class {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id])
  teacherId      String
  teacher        User         @relation("ClassTeacher", fields: [teacherId], references: [id])
  name           String // e.g. "5B Mathematics"
  gradeLevel     Int
  enrollments    Enrollment[]
  lessons        Lesson[]
  assignments    Assignment[]
  recordings     Recording[]

  @@index([schoolId])
  @@index([teacherId])
}

model Enrollment {
  classId   String
  studentId String
  class     Class    @relation(fields: [classId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())

  @@id([classId, studentId])
  @@index([studentId])
}

// A lesson follows the 8-part structure from the spec. Knowledge-check
// questions are stored as JSON: [{ prompt, options[], answerIndex, hint, explanation }].
model Lesson {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id])
  classId        String
  class          Class         @relation(fields: [classId], references: [id])
  authorId       String
  author         User          @relation("LessonAuthor", fields: [authorId], references: [id])
  title          String
  outcomeCode    String?
  scheduledFor   DateTime
  durationMin    Int           @default(30)
  objectives     String[]
  introduction   String
  explanation    String
  activity       String
  knowledgeCheck Json
  worksheet      String
  nextActivity   String
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  progress    LessonProgress[]
  assignments Assignment[]
  recordings  Recording[]

  @@index([schoolId, classId, scheduledFor])
}

model LessonProgress {
  lessonId       String
  studentId      String
  lesson         Lesson    @relation(fields: [lessonId], references: [id])
  student        User      @relation(fields: [studentId], references: [id])
  completedSteps Int[]
  checkCorrect   Int       @default(0)
  checkTotal     Int       @default(0)
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@id([lessonId, studentId])
}

model Assignment {
  id                String        @id @default(cuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id])
  classId           String
  class             Class         @relation(fields: [classId], references: [id])
  lessonId          String?
  lesson            Lesson?       @relation(fields: [lessonId], references: [id])
  authorId          String
  author            User          @relation("AssignmentAuthor", fields: [authorId], references: [id])
  title             String
  instructions      String        @default("")
  dueAt             DateTime
  // Percent deducted per day late; null = late work not accepted.
  latePenaltyPerDay Int?          @default(10)
  maxLateDays       Int           @default(3)
  status            ContentStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())

  questions   Question[]
  submissions Submission[]

  @@index([schoolId, classId, dueAt])
}

model Question {
  id           String       @id @default(cuid())
  assignmentId String
  assignment   Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  order        Int
  type         QuestionType
  prompt       String
  options      String[]
  answerIndex  Int? // MCQ only
  points       Int          @default(1)
  answers      Answer[]
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      User             @relation(fields: [studentId], references: [id])
  status       SubmissionStatus @default(IN_PROGRESS)
  submittedAt  DateTime?
  daysLate     Int              @default(0)
  rawScore     Float?
  maxScore     Float?
  finalScore   Float? // after late penalty
  feedback     String?
  gradedAt     DateTime?
  answers      Answer[]

  @@unique([assignmentId, studentId])
}

model Answer {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id])
  choiceIndex  Int?
  text         String?
  autoScore    Float?
  teacherScore Float?

  @@unique([submissionId, questionId])
}

// Rule-based in the MVP (see src/lib/recommend.ts). Every recommendation
// stores the evidence behind it so it can be explained and reviewed.
model Recommendation {
  id        String               @id @default(cuid())
  schoolId  String
  studentId String
  student   User                 @relation(fields: [studentId], references: [id])
  kind      String // REVIEW | PRACTICE | CHALLENGE
  title     String
  evidence  String[]
  lessonId  String?
  status    RecommendationStatus @default(ACTIVE)
  createdAt DateTime             @default(now())

  @@index([schoolId, studentId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
}

// ---------------- Modules beyond the MVP core ----------------

model Notification {
  id        String    @id @default(cuid())
  schoolId  String?
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      String // class | assign | grade | ai | message | system
  title     String
  body      String    @default("")
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// Consents a user (or a parent for a child) has granted. key examples:
// ai_tutor, sel_share_teacher, analytics, photo_media.
model Consent {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  key       String
  granted   Boolean
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}

// Parent <-> teacher messages, always about one student.
model Message {
  id        String    @id @default(cuid())
  schoolId  String
  fromId    String
  from      User      @relation("MessageFrom", fields: [fromId], references: [id])
  toId      String
  to        User      @relation("MessageTo", fields: [toId], references: [id])
  studentId String?
  body      String
  // Held messages (e.g. containing a phone number) wait for admin moderation.
  held      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([schoolId, toId, createdAt])
  @@index([schoolId, fromId, createdAt])
}

// Reasoning-skills practice (never reported as IQ). Items are generated in code.
model CognitiveSession {
  id          String    @id @default(cuid())
  schoolId    String
  studentId   String
  student     User      @relation(fields: [studentId], references: [id])
  domain      String // patterns | memory | verbal | spatial | speed
  level       Int       @default(1)
  items       Json // generated items with the student's answers and times
  correct     Int       @default(0)
  total       Int       @default(0)
  avgMs       Int?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([schoolId, studentId, domain])
}

// Social-emotional learning: private by default, shared with the teacher only if the student opts in.
model SelCheckin {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  mood      Int // 1..5
  feelings  String[]
  note      String   @default("")
  scenario  String?
  response  String?
  shared    Boolean  @default(false)
  // Separate choice: the student can also share an entry with their verified parents.
  sharedWithParent Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([schoolId, studentId, createdAt])
}

model SelGoal {
  id        String    @id @default(cuid())
  schoolId  String
  studentId String
  student   User      @relation(fields: [studentId], references: [id])
  text      String
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([schoolId, studentId])
}

model PointEvent {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  points    Int
  reason    String
  // Prevents awarding twice for the same thing, e.g. "lesson:<id>".
  key       String
  createdAt DateTime @default(now())

  @@unique([studentId, key])
  @@index([schoolId, createdAt])
}

model StudentBadge {
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  badge     String
  earnedAt  DateTime @default(now())

  @@id([studentId, badge])
}

// AI study buddy conversation turns (students) - kept for safety review.
model AiMessage {
  id           String   @id @default(cuid())
  schoolId     String
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  role         String // user | assistant
  content      String
  flagged      Boolean  @default(false)
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([schoolId, userId, createdAt])
}

// Teacher AI assistant drafts. Nothing reaches students until a teacher accepts it.
model AiDraft {
  id           String   @id @default(cuid())
  schoolId     String
  teacherId    String
  teacher      User     @relation(fields: [teacherId], references: [id])
  tool         String // lesson | quiz | feedback | differentiate | parent_note
  prompt       String
  output       Json
  status       String   @default("DRAFT") // DRAFT | ACCEPTED | DISCARDED
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([schoolId, teacherId, createdAt])
}

model ModerationItem {
  id           String    @id @default(cuid())
  schoolId     String?
  kind         String // ai_reply | message | content
  sourceId     String?
  summary      String
  status       String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
}

model LiveSession {
  id          String    @id @default(cuid())
  schoolId    String
  classId     String
  teacherId   String
  teacher     User      @relation(fields: [teacherId], references: [id])
  title       String
  startsAt    DateTime
  durationMin Int       @default(40)
  status      String    @default("SCHEDULED") // SCHEDULED | LIVE | ENDED
  roomName    String    @unique
  // "teams" or "meet": the teacher pasted a meeting link; "jitsi": the embedded Jitsi room;
  // "educop": Educop live (LiveKit), room = roomName.
  provider    String    @default("jitsi")
  meetingUrl  String?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  attendance LiveAttendance[]
  chat       LiveChat[]
  polls      LivePoll[]
  recordings Recording[]

  @@index([schoolId, classId, startsAt])
}

model LiveAttendance {
  sessionId  String
  session    LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  joinedAt   DateTime    @default(now())
  lastSeenAt DateTime    @default(now())
  handRaised Boolean     @default(false)
  // Educop live: the teacher invited this student to use their mic and camera.
  canSpeak   Boolean     @default(false)

  @@id([sessionId, userId])
}

model LiveChat {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  body      String
  held      Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model LivePoll {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question  String
  options   String[]
  open      Boolean     @default(true)
  votes     Json        @default("{}") // { userId: optionIndex }
  createdAt DateTime    @default(now())
}

// Recorded classes: a video with captions, chapters and in-video questions.
// chapters: [{ t: seconds, title }]
// questions: [{ id, t: seconds, prompt, options[], answerIndex, explanation }]
model Recording {
  id            String        @id @default(cuid())
  schoolId      String
  classId       String
  class         Class         @relation(fields: [classId], references: [id])
  teacherId     String
  teacher       User          @relation(fields: [teacherId], references: [id])
  lessonId      String?
  lesson        Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  liveSessionId String?
  liveSession   LiveSession?  @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)
  title         String
  description   String        @default("")
  videoUrl      String
  source        String // upload | link | demo
  durationSec   Int?
  posterUrl     String?
  captionsVtt   String? // WebVTT text
  chapters      Json          @default("[]")
  questions     Json          @default("[]")
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  views RecordingView[]

  @@index([schoolId, classId])
}

// One row per student per recording. watched holds merged [start, end] second
// ranges, so skipping ahead never counts as watching.
// answers: { questionId: { choice, correct, attempts } }
model RecordingView {
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation(fields: [studentId], references: [id])
  positionSec Float     @default(0)
  watched     Json      @default("[]")
  watchedPct  Int       @default(0)
  answers     Json      @default("{}")
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@id([recordingId, studentId])
  @@index([studentId])
}
